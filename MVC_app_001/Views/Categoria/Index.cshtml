@model IEnumerable<MVC_app_001.Models.Categoria>

@{
    ViewData["Title"] = "Planificación";
}

<div class="page-heading">
    <div>
        <h1>Planificación de recursos</h1>
        <p>Organiza categorías y disponibilidad para los eventos de EventPro.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">＋ Nueva categoría</a>
</div>

<section class="design-panel p-3 p-md-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0">Catálogo de recursos</h2>
        <span class="text-muted small">@Model.Count() categorías configuradas</span>
    </div>
    @if (!Model.Any())
    {
        <div class="empty-state">Todavía no hay categorías configuradas.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table design-table">
                <thead><tr><th>Nombre</th><th>Color</th><th>Eventos asociados</th><th class="text-end">Acciones</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Nombre</td>
                        <td><span class="status-pill" style="background:@(string.IsNullOrWhiteSpace(item.Color) ? "#dce5ff" : item.Color);">@item.Color</span></td>
                        <td>@item.Eventos.Count</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.CategoriaId" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@item.CategoriaId" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.CategoriaId" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
