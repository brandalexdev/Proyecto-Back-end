@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isLogin = controller == "Login";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - EventPro Enterprise</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/MVC_app_001.styles.css" asp-append-version="true"/>
</head>
<body>
@if (isLogin)
{
    @RenderBody()
}
else
{
    <div class="app-shell">
        <aside class="app-sidebar">
            <a class="brand-lockup" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">EP</span>
                <span><strong>EventPro</strong><small>Management Suite</small></span>
            </a>
            <nav class="sidebar-nav" aria-label="Navegación principal">
                <a class="@(controller == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index"><span>▦</span> Dashboard</a>
                <a class="@(controller == "Eventos" ? "active" : "")" asp-controller="Eventos" asp-action="Index"><span>◫</span> Eventos</a>
                <a class="@(controller == "Categoria" ? "active" : "")" asp-controller="Categoria" asp-action="Index"><span>▤</span> Planificación</a>
                <a class="@(controller == "Auditoria" ? "active" : "")" asp-controller="Auditoria" asp-action="Index"><span>◷</span> Auditoría</a>
                <a class="@(controller == "Recordatorio" ? "active" : "")" asp-controller="Recordatorio" asp-action="Index"><span>◌</span> Recordatorios</a>
            </nav>
            <a class="create-event-button" asp-controller="Eventos" asp-action="Create">＋ Crear evento</a>
        </aside>
        <div class="app-content">
            <header class="topbar">
                <div class="search-box">⌕ <input placeholder="Buscar eventos, recursos o usuarios..." aria-label="Buscar" /></div>
                <div class="topbar-actions"><button type="button" aria-label="Notificaciones">♢</button><button type="button" aria-label="Configuración">⚙</button><span class="avatar">EP</span></div>
            </header>
            <main class="page-content" role="main">@RenderBody()</main>
        </div>
    </div>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>