@model ErrorViewModel
@{
    ViewData["Title"] = "Ups, algo salió mal";
    var isNotFound = string.Equals(Context.Response?.StatusCode.ToString(), "404");
}

<div class="min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="container" style="max-width: 720px;">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5 text-center">
                <div class="display-6 mb-3">⚠</div>
                <h1 class="fw-bold mb-3">@((isNotFound) ? "Página no encontrada" : "Ups, algo salió mal")</h1>
                <p class="text-muted mb-4">
                    @((isNotFound)
                        ? "La dirección que intentaste abrir no existe o fue movida."
                        : "Ocurrió un problema al procesar tu solicitud. Intenta de nuevo en unos segundos.")
                </p>

                @if (Model.ShowRequestId)
                {
                    <p class="small text-muted mb-4">
                        Código de referencia: <code>@Model.RequestId</code>
                    </p>
                }

                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
                    <button class="btn btn-outline-secondary" type="button" onclick="history.back()">Regresar</button>
                </div>
            </div>
        </div>
    </div>
</div>
